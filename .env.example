# Copiar a .env.local y completar con los valores reales.
# .env.local nunca se sube a git (ver .gitignore: .env*.local).
#
# Ninguno de estos valores se expone al navegador — todo el acceso a la base
# pasa por las API routes del servidor. Ver docs/VERCEL_NEON_DEPLOYMENT.md.

# --- Base de datos (Neon, región AWS São Paulo) ------------------------------
# Neon → Connect → "Connection pooling" activado (host con "-pooler")
DATABASE_URL=

# --- Auth propia --------------------------------------------------------------
# Firma los tokens de sesión de app/api/auth/login. Generar una vez con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Cambiarlo invalida todas las sesiones activas.
AUTH_JWT_SECRET=
