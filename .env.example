# Copiar a .env.local y completar con los valores reales del proyecto de
# Supabase. .env.local nunca se sube a git (ver .gitignore: .env*.local).
#
# Ninguno de estos valores se expone al navegador — todo el acceso a
# Supabase pasa por las API routes del servidor. No hay ninguna dependencia
# de Firebase en este proyecto: autenticación y datos, todo Supabase/Postgres.

# --- Supabase ---------------------------------------------------------------
# Project Settings → API → Project URL (SIN /rest/v1 al final)
SUPABASE_URL=

# Project Settings → API → Secret keys → "default" (sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=

# Botón "Connect" → Direct connection → modo "Transaction pooler" (puerto 6543)
DATABASE_URL=

# --- Auth propia (sin Firebase) ----------------------------------------------
# Firma los tokens de sesión de app/api/auth/login. Generar una vez con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Cambiarlo invalida todas las sesiones activas.
AUTH_JWT_SECRET=
